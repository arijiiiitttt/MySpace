# All optional. Copy to .env and export, or set them in your host's dashboard.
PORT=8080
# Comma separated list of websites allowed to connect. Empty = anyone (fine for local dev).
# ALLOWED_ORIGINS=https://myspace.example.com
MAX_ROOM_PLAYERS=40
MAX_ROOMS=100
# Set to true behind a reverse proxy / PaaS so per-IP limits use the real client address.
TRUST_PROXY=false
# STUN/TURN servers for voice/video as JSON. Add a TURN server if people behind strict NATs can't connect.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
